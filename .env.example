# Copy to .env. Never publish private credentials.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_COLLECTION=olist_reviews
TOP_K=8
# E5 cosine scores tend to have elevated baselines; this is a heuristic,
# not a calibrated probability. Tune via evaluation on your own corpus.
MIN_SIMILARITY=0.76
